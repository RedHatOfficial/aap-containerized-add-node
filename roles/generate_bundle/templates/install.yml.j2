---
# Offline Install Playbook for {{ _target_hostname }}
# Generated by AAP Add Node Collection
#
# Run locally on the target execution node:
#   ansible-playbook -c local install.yml
#
# Prerequisites:
#   - RHEL 9 or 10 with valid subscription
#   - podman installed
#   - ansible-core installed (for this playbook)
#   - receptor container image available (pre-pulled or in bundle)

- name: Install receptor from offline bundle
  hosts: localhost
  connection: local
  become: true
  vars_files:
    - vars.yml

  vars:
    # Receptor container image - override if different version needed
    # For AAP 2.5: registry.redhat.io/ansible-automation-platform-25/receptor-rhel8:latest
    # For AAP 2.6: registry.redhat.io/ansible-automation-platform-26/receptor-rhel9:latest
    receptor_image: "{{ '{{' }} receptor_image_override | default('registry.redhat.io/ansible-automation-platform-26/receptor-rhel9:latest') {{ '}}' }}"

    # Container user ID (receptor image runs as UID 1000)
    receptor_uid: 1000
    receptor_gid: 1000

    # Installation paths
    receptor_etc: /etc/receptor
    receptor_run: /var/run/receptor
    receptor_data: /var/lib/receptor

  tasks:
    - name: Verify running as root or with become
      ansible.builtin.assert:
        that:
          - ansible_effective_user_id == 0
        fail_msg: "This playbook must run as root (use -b or become: true)"

    - name: Create receptor directories with correct ownership
      ansible.builtin.file:
        path: "{{ '{{' }} item {{ '}}' }}"
        state: directory
        mode: '0755'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"
      loop:
        - "{{ '{{' }} receptor_etc {{ '}}' }}"
        - "{{ '{{' }} receptor_etc {{ '}}' }}/tls"
        - "{{ '{{' }} receptor_etc {{ '}}' }}/tls/ca"
        - "{{ '{{' }} receptor_run {{ '}}' }}"
        - "{{ '{{' }} receptor_data {{ '}}' }}"

    - name: Copy receptor configuration
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/{{ '{{' }} receptor_conf {{ '}}' }}"
        dest: "{{ '{{' }} receptor_etc {{ '}}' }}/receptor.conf"
        mode: '0640'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"

    - name: Copy TLS certificate
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/{{ '{{' }} receptor_tls_cert {{ '}}' }}"
        dest: "{{ '{{' }} receptor_etc {{ '}}' }}/tls/receptor.crt"
        mode: '0640'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"

    - name: Copy TLS private key
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/{{ '{{' }} receptor_tls_key {{ '}}' }}"
        dest: "{{ '{{' }} receptor_etc {{ '}}' }}/tls/receptor.key"
        mode: '0400'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"

    - name: Copy mesh CA certificate
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/{{ '{{' }} receptor_ca_cert {{ '}}' }}"
        dest: "{{ '{{' }} receptor_etc {{ '}}' }}/tls/ca/mesh-CA.crt"
        mode: '0640'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"

{% if _target_type | default('execution') == 'execution' %}
    - name: Copy work signing public key
      ansible.builtin.copy:
        src: "{{ '{{' }} playbook_dir {{ '}}' }}/{{ '{{' }} receptor_work_public_key {{ '}}' }}"
        dest: "{{ '{{' }} receptor_etc {{ '}}' }}/work_public_key.pem"
        mode: '0640'
        owner: "{{ '{{' }} receptor_uid {{ '}}' }}"
        group: "{{ '{{' }} receptor_gid {{ '}}' }}"
{% endif %}

    - name: Check if receptor image bundle exists
      ansible.builtin.stat:
        path: "{{ '{{' }} playbook_dir {{ '}}' }}/images/receptor.tar"
      register: _receptor_image_bundle

    - name: Load receptor image from bundle (if present)
      ansible.builtin.command:
        cmd: "podman load -i {{ '{{' }} playbook_dir {{ '}}' }}/images/receptor.tar"
      when: _receptor_image_bundle.stat.exists
      register: _load_image
      changed_when: _load_image.rc == 0

    - name: Verify receptor image is available
      ansible.builtin.command:
        cmd: "podman image exists {{ '{{' }} receptor_image {{ '}}' }}"
      register: _image_check
      failed_when: false
      changed_when: false

    - name: Fail if receptor image not available
      ansible.builtin.fail:
        msg: |
          Receptor image not found: {{ '{{' }} receptor_image {{ '}}' }}

          Either:
          1. Pre-pull the image: podman pull {{ '{{' }} receptor_image {{ '}}' }}
          2. Or regenerate bundle with: -e aap_add_node_bundle_include_images=true
          3. Or override image: -e receptor_image_override=<your-image>

          Available images: podman images | grep receptor
      when: _image_check.rc != 0

    - name: Remove any stale receptor container
      ansible.builtin.command:
        cmd: "podman rm -f receptor"
      register: _rm_container
      failed_when: false
      changed_when: _rm_container.rc == 0

    - name: Create receptor systemd service
      ansible.builtin.copy:
        dest: /etc/systemd/system/receptor.service
        mode: '0644'
        content: |
          [Unit]
          Description=Receptor mesh node
          After=network-online.target
          Wants=network-online.target

          [Service]
          Type=simple
          ExecStartPre=-/usr/bin/podman rm -f receptor
          ExecStart=/usr/bin/podman run --rm --name receptor \
            --user {{ '{{' }} receptor_uid {{ '}}' }}:{{ '{{' }} receptor_gid {{ '}}' }} \
            -e HOME=/var/lib/receptor \
            -v {{ '{{' }} receptor_etc {{ '}}' }}:/etc/receptor:ro,Z \
            -v {{ '{{' }} receptor_run {{ '}}' }}:/var/run/receptor:Z \
            -v {{ '{{' }} receptor_data {{ '}}' }}:/var/lib/receptor:Z \
            --network=host \
            {{ '{{' }} receptor_image {{ '}}' }} \
            receptor -c /etc/receptor/receptor.conf
          ExecStop=/usr/bin/podman stop receptor
          Restart=always
          RestartSec=5

          [Install]
          WantedBy=multi-user.target

    - name: Reload systemd
      ansible.builtin.systemd:
        daemon_reload: true

    - name: Enable and start receptor service
      ansible.builtin.systemd:
        name: receptor
        state: started
        enabled: true

    - name: Wait for receptor socket
      ansible.builtin.wait_for:
        path: "{{ '{{' }} receptor_run {{ '}}' }}/receptor.sock"
        timeout: 60

    - name: Get receptor container status
      ansible.builtin.command:
        cmd: podman ps --filter name=receptor --format table
      register: _container_status
      changed_when: false

    - name: Get receptor version
      ansible.builtin.command:
        cmd: podman exec receptor receptor --version
      register: _receptor_version
      changed_when: false
      failed_when: false

    - name: Display receptor status
      ansible.builtin.debug:
        msg: |

          ═══════════════════════════════════════════════════════════════════
          RECEPTOR INSTALLED SUCCESSFULLY
          ═══════════════════════════════════════════════════════════════════

          Node ID:    {{ _target_hostname }}
          Type:       {{ _target_type | default('execution') }}
          Peers:      {{ _parsed_peers | join(', ') }}
          Version:    {{ '{{' }} _receptor_version.stdout | default('unknown') {{ '}}' }}
          Container:  {{ '{{' }} _container_status.stdout {{ '}}' }}

          NEXT STEPS:
          1. Wait 1-2 minutes for heartbeat to reach controller
          2. Check Controller UI: Administration → Topology
          3. Verify logs: journalctl -u receptor -f

          ═══════════════════════════════════════════════════════════════════
