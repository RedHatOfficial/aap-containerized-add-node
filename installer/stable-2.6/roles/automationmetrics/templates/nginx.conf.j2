#jinja2: lstrip_blocks: True

worker_processes  auto;

pid        /run/nginx/nginx.pid;
error_log  /dev/stdout error;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    log_format  main  '"$time_local" client=$remote_addr '
                      'method=$request_method request="$request" '
                      'request_length=$request_length '
                      'status=$status bytes_sent=$bytes_sent '
                      'body_bytes_sent=$body_bytes_sent '
                      'referer=$http_referer '
                      'user_agent="$http_user_agent" '
                      'upstream_addr=$upstream_addr '
                      'upstream_status=$upstream_status '
                      'request_time=$request_time '
                      'upstream_response_time=$upstream_response_time '
                      'upstream_connect_time=$upstream_connect_time '
                      'upstream_header_time=$upstream_header_time '
                      'request_id="$http_x_request_id"';

    access_log  /dev/stdout  main;

    client_body_temp_path /run/nginx/client_body;
    proxy_temp_path       /run/nginx/proxy_temp;
    fastcgi_temp_path     /run/nginx/fastcgi_temp;
    uwsgi_temp_path       /run/nginx/uwsgi_temp;
    scgi_temp_path        /run/nginx/scgi_temp;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    types_hash_max_size 4096;

    upstream metrics-service {
        server 127.0.0.1:{{ automationmetrics_api_port }};
    }

    server {
        {% if not automationmetrics_nginx_disable_https | bool %}
        listen  {{ automationmetrics_nginx_https_port }} default_server ssl http2;
        {% if ansible_all_ipv6_addresses | length > 0 %}
        listen [::]:{{ automationmetrics_nginx_https_port }} default_server ssl http2;
        {% endif %}
        {% else %}
        listen {{ automationmetrics_nginx_http_port }} default_server;
        {% if ansible_all_ipv6_addresses | length > 0 %}
        listen [::]:{{ automationmetrics_nginx_http_port }} default_server;
        {% endif %}
        {% endif %}

        server_name _;
        keepalive_requests 100;
        keepalive_timeout 65;

        client_max_body_size {{ automationmetrics_nginx_client_max_body_size }};

        {% if not automationmetrics_nginx_disable_https | bool %}
        ssl_certificate /etc/ansible-automation-platform/metrics_service/metrics_service.crt;
        ssl_certificate_key /etc/ansible-automation-platform/metrics_service/metrics_service.key;
        ssl_session_cache shared:SSL:50m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        ssl_protocols {{ automationmetrics_nginx_https_protocols | join(' ') }};
        ssl_ciphers PROFILE=SYSTEM;
        ssl_prefer_server_ciphers on;
        {% endif %}

        {% if not automationmetrics_nginx_disable_https | bool and not automationmetrics_nginx_disable_hsts | bool %}
        add_header Strict-Transport-Security max-age={{ automationmetrics_nginx_hsts_max_age }} always;
        {% endif %}

        # headers added with automationmetrics_nginx_user_headers variable
{% for header in automationmetrics_nginx_user_headers %}
        add_header {{ header }};
{% endfor %}
        # end of headers added with automationmetrics_nginx_user_headers variable

        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options nosniff always;

        gzip on;
        gzip_comp_level 6;
        gzip_proxied any;
        gzip_types text/css text/javascript text/plain text/xml application/javascript application/json application/xml;
        gzip_vary on;

        location / {
            proxy_pass http://metrics-service;
            proxy_read_timeout {{ automationmetrics_nginx_read_timeout }}s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            {% if not automationmetrics_nginx_disable_https | bool %}
            proxy_set_header X-Forwarded-Proto $scheme;
            {% endif %}

            error_page 504 =503 /json_503;
            error_page 502 =503 /json_503;
        }

        location = /json_503 {
            internal;
            add_header Content-Type application/json;

            if ($http_x_request_id) {
                return 503 '{"status": "error", "message": "Service Unavailable", "code": 503, "request_id": "$http_x_request_id"}';
            }

            return 503 '{"status": "error", "message": "Service Unavailable", "code": 503}';
        }
    }
    {% if not automationmetrics_nginx_disable_https | bool %}
    server {
        listen {{ automationmetrics_nginx_http_port }} default_server;
        {% if ansible_all_ipv6_addresses | length > 0 %}
        listen [::]:{{ automationmetrics_nginx_http_port }} default_server;
        {% endif %}
        server_name _;
        {% if automationmetrics_nginx_https_port | int == 443 %}
        return 301 https://$host$request_uri;
        {% else %}
        return 301 https://$host:{{ automationmetrics_nginx_https_port }}$request_uri;
        {% endif %}
    }
    {% endif %}
}
