---
profile: production

exclude_paths:
  - .git/
  - collections/
  - site/
  - changelogs/

skip_list:
  - name[casing]  # Allow task names with mixed case
  - name[template]  # Allow Jinja in task names for dynamic per-host naming
  - var-naming[no-role-prefix]  # Collection uses shared aap_add_node_* prefix across roles
  - no-handler  # Some tasks legitimately run on changed without being handlers

warn_list:
  - experimental

enable_list:
  - no-changed-when
  - no-handler
